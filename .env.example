# only-stock 环境变量模板（依据 docs/13-Docker部署与运维.md 10.2、10.4）
# 复制为 .env 后按需填写；.env 不得提交到仓库。
# 初始管理员只在空库首次启动时创建；创建成功后同时删除用户名与密码两行（或都留空）。

APP_ENV=development

# 数据与备份目录
DATA_DIR=./data
BACKUP_DIR=./backups

# 每日备份
BACKUP_TIME=02:00
BACKUP_RETENTION_SETS=7

# 会话有效期
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=24

# MCP 限流与允许的 Host（不要配置为允许任意 Host）
MCP_KEY_RATE_PER_MINUTE=60
MCP_IP_RATE_PER_MINUTE=120
MCP_ALLOWED_HOSTS=127.0.0.1,localhost

TZ=Asia/Shanghai

# 首次启动初始化公司管理员；留空表示不初始化
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
